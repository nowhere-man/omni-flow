ALTER TABLE account ADD COLUMN credit_limit_minor INTEGER NOT NULL DEFAULT 0;
ALTER TABLE account ADD COLUMN available_limit_minor INTEGER;
ALTER TABLE account ADD COLUMN profit_loss_minor INTEGER NOT NULL DEFAULT 0;
ALTER TABLE account ADD COLUMN owner_role TEXT NOT NULL DEFAULT 'HUSBAND';

CREATE TABLE reconciliation_entry (
    id TEXT NOT NULL PRIMARY KEY,
    account_id TEXT NOT NULL REFERENCES account(id),
    period TEXT NOT NULL,
    date INTEGER NOT NULL,
    credit_limit_minor INTEGER NOT NULL DEFAULT 0,
    available_limit_minor INTEGER,
    debt_minor INTEGER NOT NULL DEFAULT 0,
    deposit_minor INTEGER NOT NULL DEFAULT 0,
    investment_minor INTEGER NOT NULL DEFAULT 0,
    profit_loss_minor INTEGER NOT NULL DEFAULT 0,
    owner_role TEXT NOT NULL DEFAULT 'HUSBAND',
    created_at INTEGER NOT NULL
);

CREATE TABLE monthly_reconciliation_meta (
    period TEXT NOT NULL PRIMARY KEY,
    husband_income_minor INTEGER NOT NULL DEFAULT 0,
    wife_income_minor INTEGER NOT NULL DEFAULT 0,
    notes TEXT NOT NULL DEFAULT '',
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);
