CREATE TABLE reconciliation_entry (
    id TEXT NOT NULL PRIMARY KEY,
    account_id TEXT NOT NULL REFERENCES account(id),
    period TEXT NOT NULL,
    date INTEGER NOT NULL,
    credit_limit_minor INTEGER NOT NULL DEFAULT 0,
    available_limit_minor INTEGER,
    debt_minor INTEGER NOT NULL DEFAULT 0,
    deposit_minor INTEGER NOT NULL DEFAULT 0,
    investment_minor INTEGER NOT NULL DEFAULT 0,
    profit_loss_minor INTEGER NOT NULL DEFAULT 0,
    owner_role TEXT NOT NULL DEFAULT 'HUSBAND',
    created_at INTEGER NOT NULL
);

CREATE TABLE monthly_reconciliation_meta (
    period TEXT NOT NULL PRIMARY KEY,
    husband_income_minor INTEGER NOT NULL DEFAULT 0,
    wife_income_minor INTEGER NOT NULL DEFAULT 0,
    notes TEXT NOT NULL DEFAULT '',
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

insertEntry:
INSERT INTO reconciliation_entry(
    id, account_id, period, date, credit_limit_minor, available_limit_minor,
    debt_minor, deposit_minor, investment_minor, profit_loss_minor, owner_role, created_at
) VALUES (
    :id, :account_id, :period, :date, :credit_limit_minor, :available_limit_minor,
    :debt_minor, :deposit_minor, :investment_minor, :profit_loss_minor, :owner_role, :created_at
);

entriesForPeriod:
SELECT * FROM reconciliation_entry WHERE period = :period ORDER BY date DESC;

allDistinctPeriods:
SELECT DISTINCT period FROM reconciliation_entry ORDER BY period DESC;

allEntries:
SELECT * FROM reconciliation_entry ORDER BY period ASC, date ASC;

upsertMeta:
INSERT OR REPLACE INTO monthly_reconciliation_meta(period, husband_income_minor, wife_income_minor, notes, created_at, updated_at)
VALUES (:period, :husband_income_minor, :wife_income_minor, :notes, :created_at, :updated_at);

metaForPeriod:
SELECT * FROM monthly_reconciliation_meta WHERE period = :period;

allMetas:
SELECT * FROM monthly_reconciliation_meta ORDER BY period ASC;
